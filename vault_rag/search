#!/bin/bash
# Смысловой поиск по vault через дежурного (держит модель, досборка на лету).
# Пути — относительно расположения скрипта (через симлинк работает на любой машине).
# Usage: ./search "запрос" [k]
DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$DIR/venv/bin/python" "$DIR/search_client.py" "$@"
