# ─── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:your-bot-token-here          # used by the minimal bot.py
TELEGRAM_BOT_TOKEN_FILE=/etc/tg-bot/token              # used by the full tg_bot.py
TELEGRAM_ALLOWLIST=11111111,22222222                   # user ids allowed to use the bot
TELEGRAM_ALLOWLIST_FILE=/etc/tg-bot/allowlist
BOT_USERNAME=your_bot

# Native voice transcription via a Premium user session (telethon).
TELEGRAM_ENV_FILE=/etc/tg-bot/telethon.env             # holds TELEGRAM_API_ID/HASH/SESSION_STRING
NATIVE_TRANSCRIBE_PYTHON=python3

# ─── Claude Code engine ──────────────────────────────────────────────────────
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-opus-4-7
AGENT_CWD=.
SYSTEM_PROMPT_FILE=prompts/system_prompt.example.md
BOT_HOME=/home/agent
BOT_CACHE_DIR=/home/agent/.cache/tg-bot
BOT_SECRETS_DIR=/etc/tg-bot

# ─── Voice output / external tools (optional) ────────────────────────────────
EDGE_TTS_BIN=edge-tts
ZVUKOGRAM_KEY_PATH=/etc/tg-bot/zvukogram.key
VOICE_CERT=/etc/tg-bot/voice-cert.pem
VOICE_KEY=/etc/tg-bot/voice-key.pem
CHATLOG_SCRIPT=/path/to/chatlog-indexer

# ─── Deep-research browser bridge (optional) ─────────────────────────────────
RESEARCH_USER_DATA=/path/to/browser/profile            # persistent, already-logged-in profile
RESEARCH_CHROME_BIN=/path/to/chrome
RESEARCH_AUTH=/path/to/storage_state.json
RESEARCH_LOGIN_URL=https://example.com/login
RESEARCH_NEW_URL=https://example.com/new
RESEARCH_BASE_URL=https://example.com/new
RESEARCH_LOG=/tmp/research.log
RESEARCH_DL_DIR=/tmp/research-downloads
RESEARCH_CODE_FILE=/tmp/login-code.txt
ASSISTANT_EMAIL=you@example.com
MAGIC_LINK=                                            # one-time login link, pasted at runtime
