# /etc/systemd/system/claude-tg-bot.service
# Main Telegram bot — Claude Code orchestrator (inbox writer + resident assistant).
# Install: cp this file to /etc/systemd/system/claude-tg-bot.service
#          then: systemctl daemon-reload && systemctl enable --now claude-tg-bot

[Unit]
Description=Claude TG-funnel bot (Inbox writer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<bot-user>
Group=<bot-user>
WorkingDirectory=%h
ExecStart=/usr/bin/python3 %h/tg-bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

# --- sandbox drop-in (save as claude-tg-bot.service.d/sandbox.conf) ---
# Relaxed from full hardening because the bot runs Claude Code (needs namespaces)
# and sudo NOPASSWD for admin tasks.  Tighten if those are not required.
#
# [Service]
# NoNewPrivileges=no
# PrivateTmp=yes
# PrivateDevices=no
# ProtectSystem=full
# ProtectKernelModules=yes
# ProtectKernelLogs=yes
# ProtectControlGroups=yes
# ProtectClock=yes
# ProtectHostname=yes
# RestrictSUIDSGID=no
# RestrictRealtime=yes
# LockPersonality=yes
# RemoveIPC=yes
# RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# SystemCallArchitectures=native
